---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar';

interface Props {
	title?: string;
	description?: string;
	lang?: 'es' | 'en';
	themeColor?: string;
}

const {
	title = 'Trizap Software',
	description = 'Trizap desarrolla software a medida y soluciones digitales para ayudar a empresas a innovar, crecer y escalar sus operaciones.',
	lang = 'es',
	themeColor = '#ffffff',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://trizap.vercel.app');
const site = siteUrl.toString().replace(/\/$/, '');
const canonicalUrl = new URL(Astro.url.pathname, `${site}/`).toString();
const socialImage = new URL('/headerLigth2.png', `${site}/`).toString();
const locale = lang === 'es' ? 'es_AR' : 'en_US';
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': `${site}#organization`,
			name: 'Trizap',
			url: site,
			logo: socialImage,
		},
		{
			'@type': 'WebSite',
			'@id': `${site}#website`,
			url: site,
			name: 'Trizap Software',
			publisher: { '@id': `${site}#organization` },
		},
		{
			'@type': 'WebPage',
			'@id': `${canonicalUrl}#webpage`,
			url: canonicalUrl,
			name: title,
			description,
			inLanguage: locale,
			isPartOf: { '@id': `${site}#website` },
		},
	],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content={themeColor} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Trizap Software" />
		<meta property="og:locale" content={locale} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content="Trizap Software" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<meta name="twitter:image:alt" content="Trizap Software" />
		<link rel="icon" type="image/png" sizes="32x32" href="/trizap.png?v=2" />
		<link rel="apple-touch-icon" sizes="180x180" href="/trizap.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400;1,600&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			(() => {
				try {
					const storedLanguage = localStorage.getItem('trizap-language');
					if (storedLanguage === 'es' || storedLanguage === 'en') document.documentElement.lang = storedLanguage;
				} catch {
					// Use the layout default when storage is unavailable.
				}
			})();
		</script>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
		<ClientRouter />
	</head>
	<body>
		<Navbar client:load defaultLanguage={lang} />
		<slot />
		<Footer />
		<script is:inline>
			const applyLanguage = (language) => {
				const currentLanguage = language === 'en' ? 'en' : 'es';

				document.querySelectorAll('[data-i18n-es][data-i18n-en]').forEach((element) => {
					const value = element.getAttribute(`data-i18n-${currentLanguage}`);
					if (value !== null) element.textContent = value;
				});

				document.querySelectorAll('[data-i18n-aria-label-es][data-i18n-aria-label-en]').forEach((element) => {
					const value = element.getAttribute(`data-i18n-aria-label-${currentLanguage}`);
					if (value !== null) element.setAttribute('aria-label', value);
				});

				document.querySelectorAll('[data-i18n-href-es][data-i18n-href-en]').forEach((element) => {
					const value = element.getAttribute(`data-i18n-href-${currentLanguage}`);
					if (value !== null) element.setAttribute('href', value);
				});
			};

			applyLanguage(document.documentElement.lang);
			new MutationObserver(() => applyLanguage(document.documentElement.lang)).observe(document.documentElement, {
				attributes: true,
				attributeFilter: ['lang'],
			});
		</script>
	</body>
</html>
