---
import ArrowLeft5 from 'reicon-react/icons/ArrowLeft5';
import Code from 'reicon-react/icons/Code';
import { slide } from 'astro:transitions';
import Layout from '../layouts/Layout.astro';

const stack = [
	{
		number: '01',
		name: 'Javascript',
		description: 'JavaScript is a language designed to add interactivity with web pages and create web apps.',
		esDescription: 'JavaScript es un lenguaje diseñado para agregar interactividad a las páginas web y crear aplicaciones web.',
	},
	{
		number: '02',
		name: 'React JS',
		description: 'A JavaScript library for building user interfaces. Declarative and component based.',
		esDescription: 'Una biblioteca de JavaScript para construir interfaces de usuario, declarativa y basada en componentes.',
	},
	{
		number: '03',
		name: 'Angular JS',
		description: 'It is a framework based on JavaScript to create single page web applications.',
		esDescription: 'Es un framework basado en JavaScript para crear aplicaciones web de una sola página.',
	},
	{
		number: '04',
		name: 'TypeScript',
		description: "It's a superset of JavaScript, which essentially adds static types and class-based objects.",
		esDescription: 'Es un superconjunto de JavaScript que agrega tipos estáticos y objetos basados en clases.',
	},
	{
		number: '05',
		name: 'Node JS',
		description: 'Node.js is a runtime environment for the server layer based on JavaScript.',
		esDescription: 'Node.js es un entorno de ejecución para la capa del servidor basado en JavaScript.',
	},
	{
		number: '06',
		name: 'CSharp',
		description: 'It is a multi-paradigm programming language on the .NET platform.',
		esDescription: 'Es un lenguaje de programación multiparadigma de la plataforma .NET.',
	},
	{
		number: '07',
		name: 'RESTful APIs',
		description: 'APIs are sets of definitions and protocols used to integrate application software.',
		esDescription: 'Las APIs son conjuntos de definiciones y protocolos utilizados para integrar software de aplicaciones.',
	},
	{
		number: '08',
		name: 'Data Base',
		description: 'We integrate with SQL, MySQL, Oracle, Mongodb or Firebase in our developments.',
		esDescription: 'Integramos SQL, MySQL, Oracle, MongoDB o Firebase en nuestros desarrollos.',
	},
];
---

<Layout
	title="Software Services | Trizap Software"
	description="Customized software development services for web, mobile, cloud computing and DevOps."
	lang="en"
>
	<main class="bg-white text-neutral-900" aria-labelledby="software-title">
		<section transition:name="software-services-card" class="bg-white px-6 pb-24 pt-28 sm:px-9 sm:pb-30 sm:pt-28" aria-labelledby="software-title">
			<div class="mx-auto w-full max-w-300">
				<a href="/#servicio" class="mb-10 inline-flex items-center gap-2 text-sm font-medium  no-underline transition-transform duration-200 hover:-translate-x-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--blue) motion-reduce:transition-none" aria-label="Back to services" data-i18n-aria-label-es="Volver a servicios" data-i18n-aria-label-en="Back to services">
					<ArrowLeft5 aria-hidden="true" size={18} weight="Outline" color="currentColor" />
					<span data-i18n-es="Volver a servicios" data-i18n-en="Back to services">Back to services</span>
				</a>
				<div class="flex flex-col items-center pb-9 text-center max-[809px]:pb-7.5">
					<Code className="mb-3.5 text-(--blue)" aria-hidden="true" size={22} weight="Filled" color="var(--blue)" />
					<h1 id="software-title" class="m-0 text-[50px] font-semibold leading-[0.94] tracking-[-0.075em] max-[640px]:text-5xl" data-i18n-es="Servicios de Software" data-i18n-en="Software Services">Software Services</h1>
					<p class="mt-4.25 max-w-200 text-[17px] font-normal leading-normal tracking-[-0.03em] text-(--muted) max-[809px]:max-w-97.5 max-[809px]:text-base" data-i18n-es="Con más de 10 años de experiencia tecnológica y un compromiso total con la entrega de productos y servicios de primera línea, TRIZAP se ha convertido en un equipo de profesionales capaz de abordar los desafíos de negocio de sus clientes mediante servicios personalizados de desarrollo de software, como desarrollo de aplicaciones web y móviles, computación en la nube y DevOps." data-i18n-en="With over 10 years of tech expertise and a full commitment to delivering front line products and services, TRIZAP has grown into a team of professionals capable of addressing clients’ business challenges by providing customized software development services such as web and mobile application development, cloud computing and DevOps.">
						With over 10 years of tech expertise and a full commitment to delivering front line products and services, TRIZAP has grown into a team of professionals capable of addressing clients’ business challenges by providing customized software development services such as web and mobile application development, cloud computing and DevOps.
					</p>
				</div>
			</div>
		</section>

		<section transition:name="service-approach" transition:animate={slide({ duration: '0.55s', delay: '0.08s', easing: 'cubic-bezier(0.22, 1, 0.36, 1)' })} class="bg-white px-6 pb-30 pt-4 sm:px-9 sm:pt-0" aria-labelledby="software-approach-title">
			<div class="mx-auto grid w-full max-w-300 gap-16 lg:grid-cols-[minmax(0,1.1fr)_minmax(20rem,0.9fr)] lg:gap-24">
				<div>
					<p class="mb-8 text-[40px] font-semibold tracking-[-0.07em]">
						<span data-i18n-es="Software" data-i18n-en="Software">Software</span>{' '}
						<span class="hero-serif bg-linear-to-r from-blue-500 to-blue-300 bg-clip-text text-[44px] font-normal text-transparent" data-i18n-es="a medida" data-i18n-en="that fits">that fits</span>
					</p>
					<div class="max-w-165 space-y-5 text-[17px] leading-normal tracking-[-0.03em] text-(--muted) max-[640px]:text-base">
						<p data-i18n-es="Nuestro equipo cuenta con experiencia comprobada en la creación de soluciones de software personalizadas para empresas grandes, medianas y pequeñas." data-i18n-en="Our team has a proven experience in creating customized software solutions for large, mid-sized and small companies.">
							Our team has a proven experience in creating customized software solutions for large, mid-sized and small companies.
						</p>
					</div>
				</div>

				<div class="flex flex-col justify-end">
					<div class="rounded-3xl border border-black/9 bg-neutral-50 p-7 sm:p-10">
						<p class="hero-serif m-0 text-4xl text-neutral-900">TRIZAP</p>
						<p class="mt-3 max-w-85 text-lg leading-snug tracking-[-0.035em] text-neutral-900" data-i18n-es="Web, mobile, cloud computing y DevOps para desafíos de negocio reales." data-i18n-en="Web, mobile, cloud computing and DevOps for real business challenges.">
							Web, mobile, cloud computing and DevOps for real business challenges.
						</p>
						<div class="mt-8 flex flex-wrap gap-2">
							{['Web', 'Mobile', 'Cloud', 'DevOps'].map((service) => (
								<span class="rounded-full border border-black/9 bg-white px-3 py-1.5 text-xs font-medium text-(--muted)">{service}</span>
							))}
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="bg-white px-6 pb-30 pt-24 sm:px-9 sm:pt-28" aria-labelledby="stack-title">
			<div class="mx-auto w-full max-w-300">
				<div class="flex flex-col items-center pb-9 text-center max-[809px]:pb-7.5">
					<Code className="mb-3.5 text-(--blue)" aria-hidden="true" size={22} weight="Filled" color="currentColor" />
					<h2 id="stack-title" class="m-0 text-[50px] font-semibold leading-[0.94] tracking-[-0.075em] max-[640px]:text-5xl" data-i18n-es="Stack Tecnológico" data-i18n-en="Technological Stack">Technological Stack</h2>
					<p class="mt-4.25 max-w-117.5 text-[17px] font-normal leading-normal tracking-[-0.03em] text-(--muted) max-[809px]:max-w-97.5 max-[809px]:text-base" data-i18n-es="Buscamos fortalecer nuestras habilidades en los stacks más demandados del mercado." data-i18n-en="We seek to enhance our skills in the most demanded stacks in the market.">
						We seek to enhance our skills in the most demanded stacks in the market.
					</p>
				</div>

				<div class="grid gap-px overflow-hidden rounded-3xl border border-black/9 bg-black/9 sm:grid-cols-2 lg:grid-cols-4 max-[809px]:rounded-2xl">
					{stack.map((technology) => (
						<article class="group relative flex min-h-54 flex-col bg-white p-7 transition-colors duration-200 hover:bg-neutral-50 motion-reduce:transition-none sm:p-8">
							<span class="absolute inset-x-8 top-0 h-px origin-left scale-x-0 bg-(--blue) transition-transform duration-300 group-hover:scale-x-100 motion-reduce:transition-none" aria-hidden="true"></span>
							<div class="flex items-center justify-between">
								<span class="text-sm font-semibold tracking-[-0.02em] text-(--blue)">{technology.number}</span>
								<span class="h-2 w-2 rounded-full bg-(--blue) opacity-40 transition-opacity duration-200 group-hover:opacity-100 motion-reduce:transition-none" aria-hidden="true"></span>
							</div>
							<h3 class="mt-9 text-2xl font-semibold tracking-tighter text-neutral-900">{technology.name}</h3>
							<p class="mt-4 text-[15px] leading-relaxed tracking-[-0.015em] text-(--muted)" data-i18n-es={technology.esDescription} data-i18n-en={technology.description}>{technology.description}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="bg-white px-6 pb-30 pt-4 sm:px-9 sm:pt-0" aria-labelledby="software-cta-title">
			<div class="mx-auto w-full max-w-300 border-t border-black/9 pt-24 sm:pt-30">
				<div class="flex flex-col items-center text-center">
					<Code className="mb-3.5 text-(--blue)" aria-hidden="true" size={22} weight="Filled" color="currentColor" />
					<h2 id="software-cta-title" class="m-0 text-[50px] font-semibold leading-[0.94] tracking-[-0.075em] max-[640px]:text-5xl" data-i18n-es="Construyamos tu próximo producto" data-i18n-en="Let's build your next product">Let's build your next product</h2>
					<p class="mt-4.25 max-w-117.5 text-[17px] font-normal leading-normal tracking-[-0.03em] text-(--muted) max-[809px]:max-w-97.5 max-[809px]:text-base" data-i18n-es="Contanos qué necesitás y encontremos la mejor solución tecnológica para tu negocio." data-i18n-en="Tell us what you need and let's find the right technology solution for your business.">
						Tell us what you need and let's find the right technology solution for your business.
					</p>
					<a href="/#contact" class="mt-8 rounded-xl bg-neutral-900 px-8 py-3.5 text-[0.95rem] font-semibold text-white no-underline transition-all duration-200 hover:-translate-y-0.5 hover:bg-neutral-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900 motion-reduce:transition-none" data-i18n-es="Hablemos de tu proyecto" data-i18n-en="Talk about your project">Talk about your project</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
