---

<Layout
	title="Terms and Conditions | Trizap"
	description="Terms and Conditions governing the use of the Trizap website and Service."
	lang="en"
>
	<div class="min-h-screen bg-white text-[#0a0a0a]">
		<main class="mx-auto w-full max-w-230 px-5 py-19 sm:px-9 sm:py-27 lg:pb-30" aria-labelledby="legal-title">
			<header class="border-b border-black/8 pb-9 sm:pb-12">
				<p class="mb-5 text-[11px] font-bold uppercase tracking-[0.16em] text-[#6b6b6b]">Trizap · Legal</p>
				<h1 id="legal-title" class="max-w-175 text-[60px] font-semibold leading-[0.98] tracking-[-0.07em]" data-i18n-es="Términos y condiciones" data-i18n-en="Terms and Conditions">Terms and Conditions</h1>
				<p class="mt-6 text-[13px] tracking-[-0.02em] text-[#6b6b6b]" data-i18n-es="Última actualización: 2 de agosto de 2026" data-i18n-en="Last updated: August 2, 2026">Last updated: August 2, 2026</p>
			</header>

			<p class="mx-auto mt-8 max-w-180" class={textClasses} data-i18n-es="Lee detenidamente estos términos y condiciones antes de utilizar nuestro servicio." data-i18n-en="Please read these Terms and Conditions carefully before using Our Service.">Please read these Terms and Conditions carefully before using Our Service.</p>

			<article class="mx-auto mt-9.5 grid max-w-180 gap-9 sm:mt-13 sm:gap-10.5">
				{sections.map((section, sectionIndex) => (
					<section class="scroll-mt-8">
						<h2 class={headingClasses} data-i18n-es={spanishTitles[sectionIndex]} data-i18n-en={section.title}>{section.title}</h2>
						{section.paragraphs?.map((paragraph, paragraphIndex) => <p class={textClasses} data-i18n-es={spanishParagraphs[sectionIndex][paragraphIndex]} data-i18n-en={paragraph}>{paragraph}</p>)}
						{section.definitions && (
							<div class="mt-4 grid gap-4">
								{section.definitions.map(([term, definition], definitionIndex) => (
									<p class={textClasses}><strong class="font-semibold text-[#0a0a0a]" data-i18n-es={spanishDefinitions[definitionIndex][0]} data-i18n-en={term}>{term}</strong> <span data-i18n-es={spanishDefinitions[definitionIndex][1]} data-i18n-en={definition}>{definition}</span></p>
								))}
							</div>
						)}
						{section.subsections?.map((subsection, subsectionIndex) => (
							<div>
								<h3 class={subheadingClasses} data-i18n-es={spanishSubsections[sectionIndex][subsectionIndex].title} data-i18n-en={subsection.title}>{subsection.title}</h3>
								{subsection.paragraphs.map((paragraph, paragraphIndex) => <p class={textClasses} data-i18n-es={spanishSubsections[sectionIndex][subsectionIndex].paragraphs[paragraphIndex]} data-i18n-en={paragraph}>{paragraph}</p>)}
							</div>
						))}
						{section.contact && <p class={textClasses}><span data-i18n-es="Por email: " data-i18n-en="By email: ">By email: </span><a class={linkClasses} href="mailto:info@trizap.net">info@trizap.net</a></p>}
					</section>
				))}
			</article>
		</main>
	</div>
</Layout>
