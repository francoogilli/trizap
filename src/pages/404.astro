---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="404 — Pagina no encontrada"
	description="La ruta que buscas ya no está disponible o cambió de ubicación."
	lang="es"
	themeColor="#f4f6fb"
>
	<div class="signal-page" id="signal-page">
		<div class="ambient" aria-hidden="true"></div>
		<div class="cursor-light" aria-hidden="true"></div>
		<div class="orbital-field" aria-hidden="true">
			<span class="orbit orbit-one"></span>
			<span class="orbit orbit-two"></span>
			<span class="orbit orbit-three"></span>
		</div>
		<canvas id="particle-canvas" aria-hidden="true"></canvas>
		<div class="vignette" aria-hidden="true"></div>
		<div class="grain" aria-hidden="true"></div>

		<main class="signal-main">
			<section class="lost-scene" aria-labelledby="lost-title">
				<div class="ghost-code" aria-hidden="true">404</div>

				<div class="coordinate coordinate-left" aria-hidden="true">
				</div>
				<div class="coordinate coordinate-right" aria-hidden="true">
				</div>

				<div class="hero-copy">
					<h1 id="lost-title">
						<span>Esta ruta quedó fuera</span>
						<span>del <em>sistema.</em></span>
					</h1>

					<div class="resolution-row">
						<p>
							La página que buscas no está disponible o cambió de ubicación. Volvamos al producto y encontremos el camino correcto.
						</p>
					</div>
				</div>
			</section>
		</main>

	</div>
</Layout>

<style>
	:global(html) {
		overflow-x: hidden;
		background: #f4f6fb;
	}

	:global(body) {
		overflow-x: hidden;
		background: #f4f6fb;
	}

	.signal-page {
		--pointer-x: 50%;
		--pointer-y: 42%;
		--background: #f4f6fb;
		--text-primary: #18213a;
		--text-muted: rgba(40, 54, 88, 0.64);
		--line: rgba(37, 57, 99, 0.18);
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-rows: auto 1fr auto;
		width: 100%;
		height: 100vh;
		height: 100svh;
		min-height: 560px;
		overflow: hidden;
		color: var(--text-primary);
		font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
		background:
			radial-gradient(circle at 50% 38%, rgba(108, 180, 255, 0.28), transparent 35%),
			linear-gradient(145deg, #ffffff 0%, #ffffff 48%, #ffffff 100%);
	}

	.ambient {
		position: absolute;
		inset: -30%;
		z-index: 1;
		pointer-events: none;
		background:
			radial-gradient(circle at 35% 42%, rgba(0, 117, 242, 0.14), transparent 22%),
			radial-gradient(circle at 64% 49%, rgba(42, 154, 255, 0.1), transparent 25%),
			radial-gradient(circle at 56% 24%, rgba(114, 162, 235, 0.08), transparent 18%);
		filter: blur(20px);
		animation: ambient-drift 22s ease-in-out infinite alternate;
	}

	.cursor-light {
		position: absolute;
		inset: 0;
		z-index: 4;
		pointer-events: none;
		background: radial-gradient(
			440px circle at var(--pointer-x) var(--pointer-y),
			rgba(0, 117, 242, 0.15),
			rgba(90, 132, 228, 0.06) 38%,
			transparent 70%
		);
		opacity: 0;
		transition: opacity 800ms ease;
	}

	.signal-page.pointer-active .cursor-light {
		opacity: 1;
	}

	.cursor-light::after {
		position: absolute;
		left: var(--pointer-x);
		top: var(--pointer-y);
		width: 266px;
		height: 266px;
		content: "";
		background: conic-gradient(
			from 0deg,
			transparent 0 20%,
			rgba(0, 117, 242, 0.48) 29%,
			transparent 38% 62%,
			rgba(79, 130, 223, 0.3) 72%,
			transparent 82%
		);
		border-radius: 50%;
		opacity: 0.28;
		mask: radial-gradient(circle, transparent 0 43%, #000 47% 49%, transparent 53%);
		transform: translate(-50%, -50%);
		animation: cursor-orbit 8s linear infinite;
	}

	.orbital-field {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		opacity: 0.54;
	}

	.orbit {
		position: absolute;
		left: 50%;
		top: 42%;
		display: block;
		border: 1px solid rgba(0, 117, 242, 0.16);
		border-radius: 50%;
		transform: translate(-50%, -50%) rotate(-7deg);
	}

	.orbit::after {
		position: absolute;
		top: 50%;
		left: -2px;
		width: 3px;
		height: 3px;
		content: "";
		background: #0075f2;
		border-radius: 50%;
		box-shadow: 0 0 11px rgba(0, 117, 242, 0.55);
	}

	.orbit-one {
		width: min(71vw, 940px);
		height: min(38vw, 450px);
	}

	.orbit-two {
		width: min(57vw, 760px);
		height: min(29vw, 340px);
		border-color: rgba(0, 117, 242, 0.11);
		transform: translate(-50%, -50%) rotate(9deg);
	}

	.orbit-three {
		width: min(46vw, 620px);
		height: min(23vw, 275px);
		border-style: dashed;
		border-color: rgba(74, 131, 220, 0.14);
		transform: translate(-50%, -50%) rotate(-2deg);
	}

	#particle-canvas {
		position: absolute;
		inset: 0;
		z-index: 3;
		width: 100%;
		height: 100%;
		pointer-events: none;
		opacity: 0;
		filter: blur(7px);
		animation: canvas-arrival 2.4s 0.15s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	.vignette {
		position: absolute;
		inset: 0;
		z-index: 8;
		pointer-events: none;
		background:
			radial-gradient(ellipse at 50% 43%, transparent 32%, rgba(224, 229, 242, 0.16) 63%, rgba(230, 234, 245, 0.72) 100%),
			linear-gradient(90deg, rgba(224, 229, 242, 0.42), transparent 16%, transparent 84%, rgba(224, 229, 242, 0.42));
	}

	.grain {
		position: absolute;
		inset: -70%;
		z-index: 9;
		pointer-events: none;
		opacity: 0.04;
		background:
			repeating-radial-gradient(circle at 17% 32%, transparent 0 1px, rgba(51, 72, 118, 0.22) 1.5px 2px, transparent 2.5px 4px),
			repeating-radial-gradient(circle at 73% 61%, transparent 0 1px, rgba(103, 119, 177, 0.2) 1.5px 2px, transparent 2.5px 5px);
		background-size: 9px 11px, 13px 15px;
		mix-blend-mode: soft-light;
		animation: grain-shift 450ms steps(2) infinite;
	}

	.signal-header,
	.signal-footer {
		position: relative;
		z-index: 12;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.signal-header {
		padding: clamp(24px, 4.4vh, 48px) clamp(24px, 4vw, 68px) 0;
		opacity: 0;
		transform: translateY(-14px);
		animation: reveal-down 1.2s 0.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	.signal-brand {
		--magnet-x: 0px;
		--magnet-y: 0px;
		display: inline-flex;
		gap: 12px;
		align-items: center;
		padding: 0;
		color: inherit;
		text-decoration: none;
		background: transparent;
		border: 0;
		border-radius: 0;
		box-shadow: none;
		transform: translate(var(--magnet-x), var(--magnet-y));
		transition: transform 620ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.brand-logo {
		display: block;
		width: 100px;
		height: auto;
	}

	.header-status {
		display: inline-flex;
		gap: 9px;
		align-items: center;
		color: rgba(0, 81, 166, 0.78);
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 8px;
		letter-spacing: 0.16em;
	}

	.status-dot {
		width: 4px;
		height: 4px;
		background: #0075f2;
		border-radius: 50%;
		box-shadow: 0 0 11px rgba(0, 117, 242, 0.65);
		animation: status-pulse 2.8s ease-in-out infinite;
	}

	.signal-main,
	.lost-scene {
		position: absolute;
		inset: 0;
		z-index: 6;
	}

	.ghost-code {
		position: absolute;
		top: 42%;
		left: 50%;
		color: transparent;
		font-family: Arial, Helvetica, sans-serif;
		font-size: min(37vw, 49vh, 510px);
		font-weight: 900;
		line-height: 0.76;
		letter-spacing: -0.095em;
		white-space: nowrap;
		-webkit-text-stroke: 0.75px rgba(0, 117, 242, 0.28);
		text-shadow:
			0 0 18px rgba(0, 117, 242, 0.18),
			0 0 72px rgba(66, 124, 219, 0.1);
		opacity: 0;
		mix-blend-mode: multiply;
		transform: translate(-50%, -50%) scale(0.96);
		animation: ghost-arrival 2.2s 0.15s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	.coordinate {
		position: absolute;
		top: 41.5%;
		display: flex;
		gap: 8px;
		align-items: center;
		color: rgba(0, 80, 165, 0.58);
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 7px;
		letter-spacing: 0.18em;
	}

	.coordinate span {
		display: block;
		width: 18px;
		height: 1px;
		background: rgba(0, 80, 165, 0.34);
	}

	.coordinate-left {
		left: clamp(24px, 8vw, 116px);
	}

	.coordinate-right {
		right: clamp(24px, 8vw, 116px);
	}

	.hero-copy {
		position: absolute;
		top: clamp(400px, 60vh, 570px);
		left: 50%;
		z-index: 7;
		width: min(calc(100% - 48px), 970px);
		padding-top: clamp(18px, 3.2vh, 30px);
		transform: translateX(-50%);
	}

	h1 {
		max-width: 970px;
		margin: 0;
		font-size: clamp(38px, 4.8vw, 70px);
		font-weight: 450;
		line-height: 0.96;
		letter-spacing: -0.064em;
		text-align: center;
		text-wrap: balance;
		opacity: 0;
		transform: translateY(20px);
		animation: reveal-up 1.35s 0.78s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	h1 span {
		display: block;
	}

	h1 em {
		font-family: "Iowan Old Style", "Bodoni 72", "Bodoni MT", "Source Serif 4", Didot, Georgia, serif;
		font-style: italic;
		font-weight: 400;
		letter-spacing: -0.045em;
		background: linear-gradient(105deg, #005dc4 5%, #0075f2 47%, #5b8fe1 92%);
		background-clip: text;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.resolution-row {
		display: block;
		margin-top: clamp(22px, 3.2vh, 35px);
		opacity: 0;
		transform: translateY(18px);
		animation: reveal-up 1.35s 0.94s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	.resolution-row p {
		max-width: 520px;
		margin: 0 auto;
		color: var(--text-muted);
		font-size: 12px;
		line-height: 1.75;
		letter-spacing: -0.012em;
		text-align: center;
	}

	.signal-brand:focus-visible {
		outline: 1px solid rgba(0, 102, 208, 0.95);
		outline-offset: 5px;
	}

	.signal-footer {
		align-self: end;
		padding: 0 clamp(24px, 4vw, 68px) max(clamp(23px, 3.7vh, 41px), env(safe-area-inset-bottom));
		color: rgba(0, 84, 170, 0.62);
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 7px;
		letter-spacing: 0.17em;
		opacity: 0;
		animation: simple-reveal 1.4s 1s ease forwards;
	}

	.footer-instruction {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		white-space: nowrap;
	}

	.equalizer {
		display: flex;
		gap: 3px;
		align-items: flex-end;
		height: 14px;
	}

	.equalizer i {
		display: block;
		width: 1px;
		height: 7px;
		background: rgba(0, 97, 190, 0.58);
		transform-origin: bottom;
		animation: equalize 1.9s ease-in-out infinite alternate;
	}

	.equalizer i:nth-child(2) {
		animation-delay: -1.1s;
	}

	.equalizer i:nth-child(3) {
		animation-delay: -0.5s;
	}

	.equalizer i:nth-child(4) {
		animation-delay: -1.5s;
	}

	@media (max-width: 900px), (max-height: 720px) {
		.hero-copy {
			top: clamp(355px, 55vh, 400px);
			width: min(calc(100% - 48px), 850px);
		}

		h1 {
			font-size: clamp(38px, 5.2vw, 62px);
		}

		.resolution-row {
			margin-top: 18px;
		}

	}

	@media (max-width: 720px) {
		.signal-page {
			min-height: 620px;
		}

		.signal-header {
			padding:
				max(20px, env(safe-area-inset-top))
				20px
				0;
		}

		.header-status {
			gap: 0;
		}

		.status-label {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
			clip-path: inset(50%);
			white-space: nowrap;
		}

		.status-dot {
			width: 5px;
			height: 5px;
		}

		.orbit {
			top: 35%;
		}

		.orbit-one {
			width: 86vw;
			height: 41vw;
		}

		.orbit-two {
			width: 68vw;
			height: 32vw;
		}

		.orbit-three {
			width: 53vw;
			height: 25vw;
		}

		.ghost-code {
			top: 35%;
			font-size: min(41vw, 27vh);
		}

		.coordinate {
			top: 34.5%;
			font-size: 6px;
		}

		.coordinate-left {
			left: 12px;
		}

		.coordinate-right {
			right: 12px;
		}

		.coordinate span {
			display: none;
		}

		.hero-copy {
			top: clamp(395px, 51vh, 440px);
			width: calc(100% - 40px);
			padding-top: 20px;
		}

		h1 {
			font-size: clamp(36px, 10.8vw, 56px);
			line-height: 0.94;
			text-align: left;
		}

		.resolution-row {
			margin-top: 20px;
		}

		.resolution-row p {
			max-width: 390px;
			font-size: 11px;
			line-height: 1.62;
			text-align: center;
		}


		.signal-footer {
			padding: 0 20px max(20px, env(safe-area-inset-bottom));
		}

		.footer-instruction {
			display: none;
		}

		.cursor-light::after {
			width: 190px;
			height: 190px;
		}
	}

	@media (max-width: 380px) {
		.brand-logo {
			width: 104px;
		}

		.coordinate {
			display: none;
		}

		.hero-copy {
			top: clamp(380px, 50.5vh, 415px);
		}

	}

	@media (max-height: 620px) and (min-width: 721px) {
		.signal-header {
			padding-top: 18px;
		}

		.hero-copy {
			top: 294px;
			padding-top: 18px;
		}

		h1 {
			font-size: 36px;
		}

		.resolution-row {
			margin-top: 14px;
		}

		.signal-footer {
			padding-bottom: 18px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ambient,
		.grain,
		.cursor-light::after,
		.status-dot,
		.equalizer i {
			animation: none;
		}

		.signal-header,
		#particle-canvas,
		.ghost-code,
		h1,
		.resolution-row,
		.signal-footer {
			opacity: 1;
			filter: none;
			transform: none;
			animation-duration: 1ms;
			animation-delay: 0ms;
		}

		.ghost-code {
			transform: translate(-50%, -50%);
		}
	}

	@keyframes ambient-drift {
		0% {
			transform: translate3d(-1.5%, -1%, 0) rotate(-1deg);
		}
		50% {
			transform: translate3d(2%, 1.5%, 0) rotate(1deg) scale(1.03);
		}
		100% {
			transform: translate3d(-0.5%, 2%, 0) rotate(-0.5deg);
		}
	}

	@keyframes cursor-orbit {
		to {
			transform: translate(-50%, -50%) rotate(360deg);
		}
	}

	@keyframes grain-shift {
		0% {
			transform: translate3d(-1%, 1%, 0);
		}
		100% {
			transform: translate3d(1%, -1%, 0);
		}
	}

	@keyframes canvas-arrival {
		to {
			opacity: 1;
			filter: blur(0);
		}
	}

	@keyframes ghost-arrival {
		to {
			opacity: 0.42;
			transform: translate(-50%, -50%) scale(1);
		}
	}

	@keyframes reveal-down {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes reveal-up {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes simple-reveal {
		to {
			opacity: 1;
		}
	}

	@keyframes status-pulse {
		0%,
		100% {
			opacity: 0.5;
			transform: scale(0.85);
		}
		50% {
			opacity: 1;
			transform: scale(1.15);
		}
	}

	@keyframes equalize {
		0% {
			transform: scaleY(0.35);
		}
		50% {
			transform: scaleY(1);
		}
		100% {
			transform: scaleY(0.58);
		}
	}
</style>

<script>
	const PARTICLE_COLORS = [
		[0, 117, 242],
		[39, 138, 255],
		[75, 151, 239],
		[111, 139, 215],
	];

	const clamp = (value, minimum, maximum) => Math.max(minimum, Math.min(maximum, value));

	function createRandom(seed = 404) {
		let value = seed >>> 0;
		return () => {
			value += 0x6d2b79f5;
			let result = value;
			result = Math.imul(result ^ (result >>> 15), result | 1);
			result ^= result + Math.imul(result ^ (result >>> 7), result | 61);
			return ((result ^ (result >>> 14)) >>> 0) / 4294967296;
		};
	}

	const page = document.querySelector('#signal-page');
	const canvas = document.querySelector('#particle-canvas');

	if (
		page instanceof HTMLElement &&
		canvas instanceof HTMLCanvasElement
	) {
		const context = canvas.getContext('2d', { alpha: true });
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const finePointer = window.matchMedia('(pointer: fine)');
		const random = createRandom(404);

		let width = window.innerWidth;
		let height = window.innerHeight;
		let dpr = Math.min(window.devicePixelRatio || 1, 1.6);
		let particles = [];
		let dust = [];
		let animationFrame = 0;
		let lastTime = performance.now();
		let startTime = lastTime;
		let resizeFrame = 0;
		let touchReleaseTimer = 0;

		const pointer = {
			x: width * 0.5,
			y: height * 0.42,
			smoothX: width * 0.5,
			smoothY: height * 0.42,
			moveX: 0,
			moveY: 0,
			speed: 0,
			active: false,
		};

		function shuffle(array, seededRandom) {
			for (let index = array.length - 1; index > 0; index -= 1) {
				const target = Math.floor(seededRandom() * (index + 1));
				[array[index], array[target]] = [array[target], array[index]];
			}
			return array;
		}

		function makeMaskPoints() {
			const mask = document.createElement('canvas');
			mask.width = Math.max(1, Math.floor(width));
			mask.height = Math.max(1, Math.floor(height));
			const maskContext = mask.getContext('2d', { willReadFrequently: true });
			if (!maskContext) return [];

			const fontSize = Math.min(width * 0.37, height * 0.49, 510);
			const centerY = height * (width < 720 ? 0.35 : 0.42);
			maskContext.clearRect(0, 0, width, height);
			maskContext.fillStyle = '#fff';
			maskContext.textAlign = 'center';
			maskContext.textBaseline = 'middle';
			maskContext.font = `900 ${fontSize}px Arial, sans-serif`;
			maskContext.fillText('404', width / 2, centerY);

			const image = maskContext.getImageData(0, 0, mask.width, mask.height);
			const step = width < 720 ? 5 : 7;
			const points = [];
			for (let y = 0; y < height; y += step) {
				for (let x = 0; x < width; x += step) {
					if (image.data[(Math.floor(y) * mask.width + Math.floor(x)) * 4 + 3] > 80) {
						points.push({
							x: x + (random() - 0.5) * step * 0.42,
							y: y + (random() - 0.5) * step * 0.42,
						});
					}
				}
			}
			return shuffle(points, random);
		}

		function createParticles() {
			const points = makeMaskPoints();
			if (!points.length) return;

			const particleCount =
				width < 720
					? clamp(Math.floor((width * height) / 900), 520, 780)
					: clamp(Math.floor((width * height) / 720), 1050, 1850);

			const centerX = width * 0.5;
			const centerY = height * (width < 720 ? 0.35 : 0.42);
			const previous = particles;

			particles = Array.from({ length: particleCount }, (_, index) => {
				const target = points[Math.floor((index / particleCount) * points.length) % points.length];
				const oldParticle = previous[index];
				const angle = random() * Math.PI * 2;
				const radius = Math.max(width, height) * (0.25 + random() * 0.8);
				return {
					x: oldParticle?.x ?? centerX + Math.cos(angle) * radius,
					y: oldParticle?.y ?? centerY + Math.sin(angle) * radius,
					tx: target.x,
					ty: target.y,
					vx: oldParticle?.vx ?? (random() - 0.5) * 1.8,
					vy: oldParticle?.vy ?? (random() - 0.5) * 1.8,
					size: 0.55 + random() * 1.45,
					depth: 0.25 + random() * 0.75,
					phase: random() * Math.PI * 2,
					color: Math.floor(random() * PARTICLE_COLORS.length),
					orbitSpeed: 0.46 + random() * 0.74,
				};
			});
		}

		function createDust() {
			const count = width < 720 ? 52 : 110;
			dust = Array.from({ length: count }, () => ({
				x: random() * width,
				y: random() * height,
				speed: 0.03 + random() * 0.1,
				size: 0.35 + random() * 1.15,
				alpha: 0.1 + random() * 0.38,
				depth: 0.2 + random() * 0.8,
			}));
		}

		function resize() {
			width = window.innerWidth;
			height = window.innerHeight;
			dpr = Math.min(window.devicePixelRatio || 1, 1.6);
			canvas.width = Math.max(1, Math.floor(width * dpr));
			canvas.height = Math.max(1, Math.floor(height * dpr));
			canvas.style.width = `${width}px`;
			canvas.style.height = `${height}px`;
			context?.setTransform(dpr, 0, 0, dpr, 0, 0);
			createParticles();
			createDust();
		}

		function updatePointer(event) {
			const movementX = event.clientX - pointer.x;
			const movementY = event.clientY - pointer.y;
			pointer.x = event.clientX;
			pointer.y = event.clientY;
			pointer.moveX = pointer.moveX * 0.45 + movementX * 0.55;
			pointer.moveY = pointer.moveY * 0.45 + movementY * 0.55;
			pointer.speed = clamp(Math.hypot(pointer.moveX, pointer.moveY), 0, 42);
			pointer.active = true;
			page.classList.add('pointer-active');

			if (event.pointerType === 'touch') {
				window.clearTimeout(touchReleaseTimer);
				touchReleaseTimer = window.setTimeout(() => {
					pointer.active = false;
					page.classList.remove('pointer-active');
				}, 900);
			}
		}

		function releasePointer(event) {
			if (event && 'relatedTarget' in event && event.relatedTarget) return;
			pointer.active = false;
			page.classList.remove('pointer-active');
		}

		function drawDust(delta) {
			if (!context) return;
			context.globalCompositeOperation = 'source-over';
			for (const mote of dust) {
				mote.y -= mote.speed * mote.depth * delta;
				mote.x += Math.sin(mote.y * 0.006 + mote.depth * 8) * 0.025 * delta;
				if (mote.y < -4) {
					mote.y = height + 4;
					mote.x = random() * width;
				}
				context.fillStyle = `rgba(0, 102, 220, ${mote.alpha})`;
				context.beginPath();
				context.arc(mote.x, mote.y, mote.size, 0, Math.PI * 2);
				context.fill();
			}
		}

		function drawTrails(trailGroups) {
			if (!context || reducedMotion.matches) return;
			context.lineCap = 'round';
			context.lineWidth = 0.72;
			for (let colorIndex = 0; colorIndex < trailGroups.length; colorIndex += 1) {
				const [red, green, blue] = PARTICLE_COLORS[colorIndex];
				context.beginPath();
				for (const segment of trailGroups[colorIndex]) {
					context.moveTo(segment.x, segment.y);
					context.lineTo(segment.x2, segment.y2);
				}
				context.strokeStyle = `rgba(${red}, ${green}, ${blue}, 0.13)`;
				context.stroke();
			}
		}

		function render(now) {
			if (!context) return;
			const delta = clamp((now - lastTime) / 16.6667, 0.35, 2.1);
			const time = now * 0.001;
			const age = (now - startTime) * 0.001;
			lastTime = now;

			pointer.smoothX += (pointer.x - pointer.smoothX) * 0.14;
			pointer.smoothY += (pointer.y - pointer.smoothY) * 0.14;
			pointer.moveX *= 0.92;
			pointer.moveY *= 0.92;
			pointer.speed = clamp(Math.hypot(pointer.moveX, pointer.moveY), 0, 42);

			page.style.setProperty('--pointer-x', `${pointer.smoothX}px`);
			page.style.setProperty('--pointer-y', `${pointer.smoothY}px`);

			context.setTransform(dpr, 0, 0, dpr, 0, 0);
			context.clearRect(0, 0, width, height);
			drawDust(delta);
			context.globalCompositeOperation = 'source-over';

			const influence = width < 720 ? 160 : 270;
			const motionScale = reducedMotion.matches ? 0.66 : 1;
			const idleScale = reducedMotion.matches ? 0.25 : 1;
			const spring = 0.021 * clamp(age / 2.8, 0.3, 1);
			const damping = 0.9;
			const trailGroups = PARTICLE_COLORS.map(() => []);

			for (const particle of particles) {
				const idleRadius = (1.8 + particle.depth * 4.8) * idleScale;
				const idleAngle = time * particle.orbitSpeed + particle.phase;
				const floatX = Math.cos(idleAngle) * idleRadius;
				const floatY = Math.sin(idleAngle * 0.86) * idleRadius * 0.76;
				const dx = particle.x - pointer.smoothX;
				const dy = particle.y - pointer.smoothY;
				const distance = Math.hypot(dx, dy);
				let vortexStrength = 0;

				if (pointer.active && distance < influence && distance > 0.1) {
					vortexStrength = Math.pow((influence - distance) / influence, 1.18) * motionScale;
				}

				const localSpring = spring * (1 - vortexStrength * 0.96);
				const flow =
					(0.012 + particle.depth * 0.016 * Math.sin(time * 0.54 + particle.phase)) *
					idleScale;

				particle.vx +=
					Math.sin(particle.y * 0.011 + time * 0.72 + particle.phase) * flow * delta;
				particle.vy +=
					Math.cos(particle.x * 0.009 - time * 0.61 + particle.phase) * flow * delta;

				particle.vx += (particle.tx + floatX - particle.x) * localSpring * delta;
				particle.vy += (particle.ty + floatY - particle.y) * localSpring * delta;

				if (vortexStrength > 0) {
					const unitX = dx / distance;
					const unitY = dy / distance;
					const tangentX = -unitY;
					const tangentY = unitX;
					const orbitRadius =
						42 + particle.depth * 34 + Math.min(pointer.speed, 24) * 0.9;
					const radialForce = (orbitRadius - distance) * 0.04 * vortexStrength;
					const swirlForce =
						(1.9 + particle.depth * 3.25 + pointer.speed * 0.075) * vortexStrength;

					particle.vx +=
						(unitX * radialForce +
							tangentX * swirlForce +
							pointer.moveX * vortexStrength * 0.012) *
						delta;
					particle.vy +=
						(unitY * radialForce +
							tangentY * swirlForce +
							pointer.moveY * vortexStrength * 0.012) *
						delta;
				}

				const localDamping = damping + vortexStrength * 0.046;
				particle.vx *= Math.pow(localDamping, delta);
				particle.vy *= Math.pow(localDamping, delta);

				const velocity = Math.hypot(particle.vx, particle.vy);
				const maxVelocity = 15 + pointer.speed * 0.08;
				if (velocity > maxVelocity) {
					particle.vx = (particle.vx / velocity) * maxVelocity;
					particle.vy = (particle.vy / velocity) * maxVelocity;
				}

				particle.x += particle.vx * delta;
				particle.y += particle.vy * delta;

				const currentVelocity = Math.hypot(particle.vx, particle.vy);
				if (currentVelocity > 0.48) {
					const trailScale = Math.min(3.1, 1.25 + currentVelocity * 0.13);
					trailGroups[particle.color].push({
						x: particle.x,
						y: particle.y,
						x2: particle.x - particle.vx * trailScale,
						y2: particle.y - particle.vy * trailScale,
					});
				}
			}

			drawTrails(trailGroups);

			for (const particle of particles) {
				const [red, green, blue] = PARTICLE_COLORS[particle.color];
				const shimmer = 0.54 + Math.sin(time * 1.8 + particle.phase) * 0.18;
				const baseAlpha = shimmer * (0.45 + particle.depth * 0.55);

				if (particle.size > 1.55) {
					context.fillStyle = `rgba(${red}, ${green}, ${blue}, ${baseAlpha * 0.08})`;
					context.beginPath();
					context.arc(particle.x, particle.y, particle.size * 4.2, 0, Math.PI * 2);
					context.fill();
				}

				context.fillStyle = `rgba(${red}, ${green}, ${blue}, ${baseAlpha})`;
				context.beginPath();
				context.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
				context.fill();
			}

			animationFrame = window.requestAnimationFrame(render);
		}

		function magneticMove(event) {
			if (!(event.currentTarget instanceof HTMLElement)) return;
			const bounds = event.currentTarget.getBoundingClientRect();
			const x = (event.clientX - (bounds.left + bounds.width / 2)) * 0.16;
			const y = (event.clientY - (bounds.top + bounds.height / 2)) * 0.16;
			event.currentTarget.style.setProperty('--magnet-x', `${x}px`);
			event.currentTarget.style.setProperty('--magnet-y', `${y}px`);
		}

		function magneticLeave(event) {
			if (!(event.currentTarget instanceof HTMLElement)) return;
			event.currentTarget.style.setProperty('--magnet-x', '0px');
			event.currentTarget.style.setProperty('--magnet-y', '0px');
		}

		function configureMagnetics() {
			if (!finePointer.matches || reducedMotion.matches) return;
			for (const element of document.querySelectorAll('.magnetic')) {
				element.addEventListener('pointermove', magneticMove);
				element.addEventListener('pointerleave', magneticLeave);
			}
		}

		window.addEventListener('pointermove', updatePointer, { passive: true, capture: true });
		window.addEventListener('pointerdown', updatePointer, { passive: true, capture: true });
		window.addEventListener('pointerup', releasePointer, { passive: true });
		window.addEventListener('pointercancel', releasePointer, { passive: true });
		window.addEventListener('mouseout', releasePointer, { passive: true });
		window.addEventListener(
			'resize',
			() => {
				window.cancelAnimationFrame(resizeFrame);
				resizeFrame = window.requestAnimationFrame(resize);
			},
			{ passive: true },
		);

		configureMagnetics();
		resize();
		animationFrame = window.requestAnimationFrame(render);

			document.addEventListener(
			'astro:before-swap',
			() => {
				window.cancelAnimationFrame(animationFrame);
				window.clearTimeout(touchReleaseTimer);
			},
			{ once: true },
		);
	}
</script>
