---
import Box5 from 'reicon-react/icons/Box5';
import ArrowRight5 from 'reicon-react/icons/ArrowRight5';

const products = [
	{ name: 'Fidel', description: 'Tecnología para construir relaciones que perduran.', hoverBackground: '/fidel-hover-bg2.png' },
	{ name: 'Octus', description: 'Soluciones digitales para organizaciones en movimiento.', hoverBackground: '/octus-hover-bg2.png' },
	{ name: 'Sanabit', description: 'Innovación para una vida más saludable.', hoverBackground: '/sanabit-hover-bg2.png' },
];

const hoverProducts = ['Fidel', 'Octus', 'Sanabit'];
---

<section id="products" class="bg-white px-6 pb-24 pt-24 text-neutral-900 sm:px-9 sm:pb-30 sm:pt-28" aria-labelledby="products-title">
	<div class="mx-auto w-full max-w-300">
		<div class="flex flex-col items-center pb-9 text-center max-[809px]:pb-7.5">
			<Box5 className="mb-3.5 text-(--blue)" aria-hidden="true" data-products-icon size={22} weight="Filled" color="currentColor" />
			<h2 id="products-title" class="m-0 text-[50px] font-semibold leading-[0.94] tracking-[-0.075em] max-[640px]:text-5xl" data-products-title data-i18n-es="Nuestros productos" data-i18n-en="Our products">Nuestros productos</h2>
			<p class="mt-4.25 max-w-117.5 text-[17px] font-normal leading-normal tracking-[-0.03em] text-neutral-900/55 max-[809px]:max-w-97.5 max-[809px]:text-base" data-products-description data-i18n-es="Productos propios que convierten ideas en experiencias digitales." data-i18n-en="Our own products turning ideas into digital experiences.">
				Productos propios que convierten ideas en experiencias digitales.
			</p>
		</div>

		<div class="grid gap-2 sm:grid-cols-3">
			{products.map((product) => (
				<a href="#contact" data-product-card class="group relative flex aspect-1066/1475 flex-col items-center justify-center overflow-hidden rounded-3xl border border-black/12 bg-white px-6 py-8 text-center no-underline transition-colors duration-300 hover:border-transparent hover:bg-neutral-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--blue) motion-reduce:transition-none">
					{hoverProducts.includes(product.name) && (
						<>
							<span data-product-background class="pointer-events-none absolute inset-0 z-0 scale-100 bg-cover bg-center opacity-0 transition-opacity duration-300 group-hover:opacity-100 motion-reduce:transition-none" style={`background-image: url('${product.hoverBackground}')`} aria-hidden="true"></span>
						</>
					)}
					{hoverProducts.includes(product.name) ? (
						<span data-product-brand class="relative z-10 block h-10 w-44 sm:h-12 sm:w-48">
							<img data-product-logo src={`/${product.name.toLowerCase()}.png`} alt={product.name} class="absolute inset-0 h-full w-full object-cover" width="953" height="943" loading="lazy" decoding="async" />
						</span>
					) : (
						<span class="text-3xl font-semibold tracking-[-0.06em] text-neutral-900 sm:text-4xl">{product.name}</span>
					)}
					<span data-product-cta class="absolute bottom-7 z-10 inline-flex items-center gap-1 text-sm font-medium text-neutral-900 transition-all duration-300 ease-out group-hover:font-semibold group-focus-visible:font-semibold motion-reduce:transition-none">
						<span data-i18n-es="Ver producto" data-i18n-en="View product">Ver producto</span>
						<ArrowRight5 aria-hidden="true" size={16} weight="Outline" color="currentColor" />
					</span>
					<span class="sr-only" data-i18n-es={product.description} data-i18n-en={product.description}>{product.description}</span>
				</a>
			))}
		</div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const section = document.querySelector<HTMLElement>('#products');

	if (section) {
		const icon = section.querySelector<HTMLElement>('[data-products-icon]');
		const title = section.querySelector<HTMLElement>('[data-products-title]');
		const description = section.querySelector<HTMLElement>('[data-products-description]');
		const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-product-card]'));
		const introElements = [icon, title, description, ...cards].filter((element): element is HTMLElement => Boolean(element));

		const media = gsap.matchMedia();
		media.add({ reduceMotion: '(prefers-reduced-motion: reduce)' }, ({ conditions }) => {
			if (conditions?.reduceMotion) {
				gsap.set(introElements, { clearProps: 'all' });
				return;
			}

			const intro = gsap.timeline({
				defaults: { duration: 0.65, ease: 'power3.out' },
				scrollTrigger: {
					trigger: section,
					start: 'top 80%',
					once: true,
				},
			});

			intro
				.from(icon, { autoAlpha: 0, rotation: -16, scale: 0.75, duration: 0.45 })
				.from(title, { autoAlpha: 0, y: 24 }, '-=0.2')
				.from(description, { autoAlpha: 0, y: 16, duration: 0.5 }, '-=0.3')
				.from(cards, { autoAlpha: 0, y: 42, scale: 0.96, stagger: 0.12 }, '-=0.15');

			const cleanupCards: Array<() => void> = [];

			cards.forEach((card) => {
				const background = card.querySelector<HTMLElement>('[data-product-background]');
				const logo = card.querySelector<HTMLElement>('[data-product-logo]');
				const cta = card.querySelector<HTMLElement>('[data-product-cta]');

				if (background) {
					const hoverElements = [background];
					gsap.set(hoverElements, { autoAlpha: 0 });
				}

				const setHoverState = (isActive: boolean) => {
					const duration = isActive ? 0.45 : 0.35;

					gsap.to(card, {
						y: isActive ? -6 : 0,
						scale: isActive ? 1.01 : 1,
						backgroundColor: isActive ? '#f5f5f5' : '#ffffff',
						borderColor: isActive ? 'transparent' : 'rgba(0, 0, 0, 0.12)',
						duration,
						ease: 'power3.out',
						overwrite: 'auto',
					});

					if (background) {
						gsap.to(background, { autoAlpha: isActive ? 1 : 0, scale: isActive ? 1.06 : 1, duration: 0.6, ease: 'power2.out', overwrite: 'auto' });
					}
					if (logo) {
						gsap.to(logo, { y: isActive ? -2 : 0, duration, ease: 'power2.out', overwrite: 'auto' });
					}
					if (cta) {
						gsap.to(cta, { x: isActive ? 4 : 0, color: isActive ? '#ffffff' : '#0a0a0a', duration, ease: 'power2.out', overwrite: 'auto' });
					}
				};

				const handleEnter = () => setHoverState(true);
				const handleLeave = () => setHoverState(false);

				card.addEventListener('pointerenter', handleEnter);
				card.addEventListener('pointerleave', handleLeave);
				card.addEventListener('focusin', handleEnter);
				card.addEventListener('focusout', handleLeave);

				cleanupCards.push(() => {
					card.removeEventListener('pointerenter', handleEnter);
					card.removeEventListener('pointerleave', handleLeave);
					card.removeEventListener('focusin', handleEnter);
					card.removeEventListener('focusout', handleLeave);
				});
			});

			return () => cleanupCards.forEach((cleanup) => cleanup());
		});
	}
</script>
