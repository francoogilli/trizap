---
import ArrowRight from 'reicon-react/icons/ArrowRight';
import Building from 'reicon-react/icons/Building';

const pillars = [
	{
		label: 'Misión',
		enLabel: 'Mission',
		text: 'Promover valores y empoderar a las personas fortaleciendo relaciones humanas a través de la tecnología.',
		enText: 'Promote values and empower people by strengthening human relationships through technology.',
	},
	{
		label: 'Visión',
		enLabel: 'Vision',
		text: 'Ser socios estratégicos de nuestros clientes alrededor del mundo ayudando a alcanzar el máximo potencial de cada uno.',
		enText: 'Be strategic partners to our clients around the world, helping each one reach their full potential.',
	},
];
---

<section id="about" class="relative overflow-hidden bg-white px-6 pb-30 pt-28 sm:px-9 max-[809px]:pb-23 max-[809px]:pt-20.5" aria-labelledby="about-title">
	<div class="relative mx-auto w-full max-w-300">
		<div class="flex flex-col items-center pb-14 text-center max-[809px]:pb-7.5">
			<Building className="mb-3.5 text-(--blue)" aria-hidden="true" size={22} weight="Filled" color="currentColor" />
			<h2 id="about-title" class="m-0 text-[50px] font-semibold leading-[0.94] tracking-[-0.075em] max-[640px]:text-5xl" data-i18n-es="Sobre Trizap" data-i18n-en="About Trizap">Sobre Trizap</h2>
		</div>
		<div class="grid gap-16 lg:grid-cols-[minmax(0,1.1fr)_minmax(20rem,0.9fr)] lg:gap-24">
			<div>
				<div class="max-w-165 space-y-5 text-[17px] leading-normal tracking-[-0.03em] text-(--muted) max-[640px]:text-base">
					<p data-i18n-es="Somos una comunidad que construimos software. Nacimos en 2010 como Agencia Programarte, dando soluciones web a nuestros clientes y acompañándolos en su transformación digital." data-i18n-en="We are a community that builds software. We were born in 2010 as Agencia Programarte, delivering web solutions and accompanying our clients in their digital transformation.">
						Somos una comunidad que construimos software. Nacimos en 2010 como Agencia Programarte, dando soluciones web a nuestros clientes y acompañándolos en su transformación digital.
					</p>
					<p data-i18n-es="Creamos productos integrales de nuestra propiedad y brindamos servicios de desarrollo en múltiples tecnologías, aplicando la metodología ágil Scrum. Somos aliados tecnológicos de nuestros clientes y partners desarrollando software de calidad." data-i18n-en="We create our own end-to-end products and provide development services across multiple technologies, using the agile Scrum methodology. We are our clients' technology allies and partners, building quality software.">
						Creamos productos integrales de nuestra propiedad y brindamos servicios de desarrollo en múltiples tecnologías, aplicando la metodología ágil Scrum. Somos aliados tecnológicos de nuestros clientes y partners desarrollando software de calidad.
					</p>
				</div>
				<a href="/about-us/" class="group mt-8 inline-flex items-center gap-2.5 text-sm font-semibold text-neutral-900 no-underline transition-colors duration-200 hover:text-(--blue) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--blue) motion-reduce:transition-none" data-i18n-aria-label-es="Conocé más sobre Trizap" data-i18n-aria-label-en="Learn more about Trizap" aria-label="Conocé más sobre Trizap">
					<span data-i18n-es="Conocé más sobre Trizap" data-i18n-en="Learn more about Trizap">Conocé más sobre Trizap</span>
					<span class="text-lg leading-none transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">
						<ArrowRight className="transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transition-none" size={16} weight="Outline" color="currentColor" />
					</span>
				</a>
			</div>

			<div class="flex flex-col justify-end">
				<div class="border-l border-black/10 pl-6 sm:pl-8">
					<div class="relative pb-12">
						<span class="absolute -left-7.25 top-1.5 h-3 w-3 rounded-full border-2 border-white bg-neutral-900 sm:-left-9.25" aria-hidden="true"></span>
						<p class="hero-serif m-0 text-4xl text-neutral-900">2010</p>
						<p class="mt-2 text-sm text-(--muted)" data-i18n-es="Agencia Programarte · El comienzo" data-i18n-en="Agencia Programarte · The beginning">Agencia Programarte · El comienzo</p>
					</div>
					<div class="relative">
						<span class="absolute -left-7.75 top-1.5 h-4 w-4 rounded-full border-4 border-white bg-(--blue) sm:-left-9.75" aria-hidden="true"></span>
						<p class="hero-serif m-0 bg-linear-to-r from-blue-500 to-cyan-100 bg-clip-text text-5xl text-transparent">2021</p>
						<p class="mt-2 text-sm text-(--muted)" data-i18n-es="Nos transformamos en Trizap" data-i18n-en="We became Trizap">Nos transformamos en Trizap</p>
					</div>
				</div>
			</div>
		</div>

		<div class="mt-20 grid gap-px overflow-hidden rounded-3xl border border-black/9 bg-black/9 md:grid-cols-2 sm:mt-28">
			{pillars.map((pillar) => (
				<article class="bg-neutral-50 p-7 sm:p-10">
					<p class="mb-8 text-base font-semibold uppercase tracking-widest text-(--blue)" data-i18n-es={pillar.label} data-i18n-en={pillar.enLabel}>{pillar.label}</p>
					<p class="m-0 max-w-120 text-lg leading-snug tracking-[-0.035em] text-neutral-900 sm:text-xl" data-i18n-es={pillar.text} data-i18n-en={pillar.enText}>{pillar.text}</p>
				</article>
			))}
		</div>
	</div>
</section>
