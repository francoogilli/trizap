---
import ChartBarTrendUp from 'reicon-react/icons/ChartBarTrendUp';

const title = {
	es: '¿Tenes un proyecto\nde software en mente?',
	en: 'Have a software project\nin mind?',
};
---

<section id="contact" class="bg-white py-20 max-[900px]:py-15" aria-labelledby="cta-title">
	<div class="mx-auto grid w-full max-w-275 grid-cols-[1.6fr_1fr] items-stretch gap-7.5 px-5 max-[900px]:grid-cols-1 max-[900px]:gap-8">
		<div
			class="relative isolate min-h-90 overflow-hidden rounded-3xl text-white"
			style="box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05)"
		>
			<video class="absolute inset-0 h-full w-full object-cover" autoplay loop muted playsinline preload="metadata" aria-hidden="true" tabindex="-1">
				<source src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260503_104800_bc43ae09-f494-43e3-97d7-2f8c1692cfd7.mp4" type="video/mp4" />
			</video>
			<div class="pointer-events-none absolute inset-0 bg-black/35" aria-hidden="true"></div>
			<div class="relative z-10 flex min-h-90 flex-col items-center justify-center px-10 py-20 text-center max-[640px]:px-6">
				<p class="mb-5 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-white/75">
					<ChartBarTrendUp aria-hidden="true" size={14} weight="Filled" color="currentColor" />
					<span data-i18n-es="Construyendo futuro" data-i18n-en="Building the future">Construyendo futuro</span>
				</p>
				<h2 id="cta-title" class="mb-3.75 whitespace-pre-line text-5xl font-normal leading-[1.1] tracking-[-0.03em] max-[640px]:text-4xl" data-i18n-es={title.es} data-i18n-en={title.en}>
					{title.es}
				</h2>
				<p class="mb-7.5 text-[0.95rem] font-normal text-white/85" data-i18n-es="Diseñamos y desarrollamos productos digitales que hacen avanzar tu negocio." data-i18n-en="We design and build digital products that move your business forward.">Diseñamos y desarrollamos productos digitales que hacen avanzar tu negocio.</p>
				<a
					href="mailto:hello@alwayzz.studio?subject=Hablemos%20de%20mi%20proyecto"
					data-i18n-href-es="mailto:hello@alwayzz.studio?subject=Hablemos%20de%20mi%20proyecto"
					data-i18n-href-en="mailto:hello@alwayzz.studio?subject=Lets%20talk%20about%20my%20project"
					class="rounded-xl bg-neutral-100 px-8 py-3.5 text-[0.95rem] font-semibold text-black no-underline shadow-[0_10px_20px_rgba(0,0,0,0.3)] transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_14px_30px_rgba(0,0,0,0.4)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
				>
					<span data-i18n-es="Iniciar un proyecto" data-i18n-en="Start a project">Iniciar un proyecto</span>
				</a>
			</div>
		</div>

		<div class="flex min-h-90 flex-col justify-center rounded-3xl border border-[#f0f0f0] bg-[#fafafa] p-10 max-[640px]:min-h-0 max-[640px]:p-7">
			<p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#888]" data-i18n-es="De la idea al producto" data-i18n-en="From idea to product">De la idea al producto</p>
			<h3 class="max-w-70 text-3xl font-normal leading-[1.05] tracking-[-0.04em] text-neutral-900" data-i18n-es="Construimos el software que tu negocio necesita." data-i18n-en="We build the software your business needs.">Construimos el software que tu negocio necesita.</h3>
			<p class="mt-5 max-w-75 text-[0.9rem] leading-[1.6] text-[#666]" data-i18n-es="Desde un MVP hasta una plataforma completa, te ayudamos a diseñar, desarrollar y lanzar tu próximo producto digital." data-i18n-en="From an MVP to a complete platform, we help you design, build, and launch your next digital product.">Desde un MVP hasta una plataforma completa, te ayudamos a diseñar, desarrollar y lanzar tu próximo producto digital.</p>
		</div>
	</div>
</section>
